# Copy to .env and adjust as needed. All values have sensible defaults.

# Comma/JSON list of browser origins allowed to call the API.
# CORS_ORIGINS=["http://localhost:3000"]

# MySQL connection string.
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/portfolio

# St. Louis Fed FRED API key — required for Treasury yield curve / valuation.
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
