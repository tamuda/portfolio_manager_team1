# Backend API URL (used by Server Components and Client Components)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# OpenAI API key for the time-bound portfolio brief (Dashboard button).
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Vercel AI Gateway instead of OpenAI direct
# AI_GATEWAY_API_KEY=

# Optional model override (default with OpenAI: gpt-4o-mini)
# MORNING_SUMMARY_MODEL=gpt-4o-mini
